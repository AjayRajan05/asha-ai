# Copy to `.env` for local experiments. Never commit `.env`.
#   Windows:  copy .env.example .env
#   Unix:     cp .env.example .env
# Rotate any key that ever appeared in a committed or shared `.env`.

# ---------------------------------------------------------------------------
# Optional LLM provider keys (live demos / adapters only)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GROK_API_KEY=

# ---------------------------------------------------------------------------
# Showcase demos (examples/showcase/) - offline mock by default
# ---------------------------------------------------------------------------
# ASHA_DEMO_BACKEND=mock
# ASHA_DEMO_BACKEND=gemini
# ASHA_DEMO_BACKEND=ollama
# ASHA_DEMO_GEMINI_MODEL=gemini-1.5-flash
# ASHA_DEMO_OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Hardened models / air-gap
# ---------------------------------------------------------------------------
# ASHA_MODELS_DIR=
# ASHA_MODELS_URL=https://github.com/AjayRajan05/asha-si/releases/download/asha-models-0.4.2/asha-models-0.4.2.zip
# ASHA_MODELS_ZIP=
# ASHA_MODELS_CACHE=
# ASHA_DISABLE_MODEL_DOWNLOAD=1
# ASHA_THRESHOLDS_PATH=

# ---------------------------------------------------------------------------
# ANCHOR headless defaults for CI/scripts
# ---------------------------------------------------------------------------
# ASHA_ANCHOR_INTERACTIVE=0
# ASHA_ANCHOR_WARN_POLICY=permissive
